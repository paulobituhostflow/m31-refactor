{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "m31-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/__scheduled"
    ]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "APP_ENV": "local",
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "EXTERNAL_SIDE_EFFECTS": "false",
    "AUTOMATIONS_ENABLED": "false",
    "PROVIDER_MODE": "mock",
    "LEGACY_PASSWORD_MIGRATION_ENABLED": "false",
    "LEGACY_BASE44_APP_ID": "69d51b279da069f623e291a6"
  },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "m31-local-jobs"
      },
      {
        "binding": "JOBS_DLQ",
        "queue": "m31-local-dlq"
      }
    ],
    "consumers": [
      {
        "queue": "m31-local-jobs",
        "max_batch_size": 5,
        "max_retries": 3,
        "dead_letter_queue": "m31-local-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  },
  "env": {
    "staging": {
      "name": "m31-staging",
      "vars": {
        "APP_ENV": "staging",
        "EXTERNAL_SIDE_EFFECTS": "false",
        "AUTOMATIONS_ENABLED": "false",
        "PROVIDER_MODE": "live",
        "ASAAS_BASE_URL": "https://api-sandbox.asaas.com/v3",
        "APP_ORIGIN": "https://m31-staging.paulobituadv.workers.dev",
        "LEGACY_PASSWORD_MIGRATION_ENABLED": "true",
        "LEGACY_BASE44_APP_ID": "69d51b279da069f623e291a6"
      },
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "m31-staging-jobs"
          },
          {
            "binding": "JOBS_DLQ",
            "queue": "m31-staging-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "m31-staging-jobs",
            "max_batch_size": 5,
            "max_retries": 3,
            "dead_letter_queue": "m31-staging-dlq"
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "account_id": "d68b9866ccd1569a81be66d605d6072e",
      "workers_dev": true,
      "preview_urls": false
    },
    "production": {
      "name": "m31-production",
      "vars": {
        "APP_ENV": "production",
        "EXTERNAL_SIDE_EFFECTS": "false",
        "AUTOMATIONS_ENABLED": "false",
        "PROVIDER_MODE": "live",
        "ASAAS_BASE_URL": "https://api.asaas.com/v3",
        "APP_ORIGIN": "https://m31-production.paulobituadv.workers.dev",
        "LEGACY_PASSWORD_MIGRATION_ENABLED": "false",
        "LEGACY_BASE44_APP_ID": "69d51b279da069f623e291a6"
      },
      "queues": {
        "producers": [
          {
            "binding": "JOBS",
            "queue": "m31-production-jobs"
          },
          {
            "binding": "JOBS_DLQ",
            "queue": "m31-production-dlq"
          }
        ],
        "consumers": [
          {
            "queue": "m31-production-jobs",
            "max_batch_size": 5,
            "max_retries": 3,
            "dead_letter_queue": "m31-production-dlq"
          }
        ]
      },
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "workers_dev": true,
      "preview_urls": false
    }
  }
}

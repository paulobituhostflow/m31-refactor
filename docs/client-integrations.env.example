# M31: modelo das integrações, sem valores reais.
# Não carregar como configuração pronta: campos vazios precisam ser definidos.
# Cadastre valores reais no cofre/Worker Secrets, nunca neste arquivo ou no Git.
# Um conjunto por ambiente. Ver CLIENT_CONFIGURATION.md para Supabase Auth e CI.

# Cliente: contas Asaas diferentes para sandbox e produção.
ASAAS_API_KEY=
# Equipe: URL do ambiente e novo token compartilhado com o webhook.
ASAAS_BASE_URL=
ASAAS_WEBHOOK_TOKEN=

# Cliente: servidor e token da instância WhatsApp.
UAZAPI_BASE_URL=
UAZAPI_TOKEN=
# Opcional para relay com x-webhook-token; UAZAPI nativa usa o token da instância.
UAZAPI_WEBHOOK_TOKEN=

# Cliente: API transacional e remetente autorizado. SMTP é separado no Supabase.
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Cliente: link VIP; cadastrar também como variable GitHub para o frontend.
WHATSAPP_GROUP_INVITE=
# Destinos autorizados de homologação separados por vírgula.
TEST_RECIPIENTS=

# Cliente: OAuth Drive/Sheets e planilha de camisas.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CAMISAS_SHEET_ID=
# Equipe: obter após consentimento da conta Google responsável.
GOOGLE_REFRESH_TOKEN=
# Opcionais: nomes dos destinos; o runtime tem padrões por ambiente.
GOOGLE_CARTINHAS_SHEET_NAME=
GOOGLE_BACKUP_FOLDER_NAME=

# Cliente: projeto OpenAI com faturamento e acesso aos modelos escolhidos.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# A infraestrutura já está configurada em staging.
# SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY, SUPABASE_SERVICE_ROLE_KEY,
# TOKEN_ENCRYPTION_KEY, APP_ORIGIN, CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_API_TOKEN.
# TOKEN_ENCRYPTION_KEY e EXPORT_ENCRYPTION_KEY são mantidas pela equipe.
# SMTP e Google login devem ser cadastrados no Supabase Auth, não aqui.
